* fluidi supply_burst - erzeugt von supply_burst.py
VOC ocv 0 DC 2.7
RINT ocv vbat 100
RHLD vbat vbat2 0.05
RFET vbat2 vdd 0.085
CB1 vdd cb1 8e-05 IC=2.7
RESR1 cb1 0 5m
CB2 vdd cb2 8e-05 IC=2.7
RESR2 cb2 0 5m
C5 vdd 0 5u IC=2.7
VPDC pdc 0 PWL(0 1.15e-06 0.001 1.15e-06 0.001001 0.0004 0.00154 0.0004 0.001541 0.0026 0.00304 0.0026 0.003041 0.0079 0.003604 0.0079 0.003605 0.0053 0.004204 0.0053 0.004205 0.0079 0.004768 0.0079 0.004769 0.0053 0.005368 0.0053 0.005369 0.0079 0.005932 0.0079 0.005933 0.0053 0.006532 0.0053 0.006533 0.0026 0.007282 0.0026 0.007283 1.15e-06)
VPLDO pldo 0 PWL(0 1.15e-06 0.001 1.15e-06 0.001001 0.0004 0.00154 0.0004 0.001541 0.0041 0.00304 0.0041 0.003041 0.0139412 0.003604 0.0139412 0.003605 0.009 0.004204 0.009 0.004205 0.0139412 0.004768 0.0139412 0.004769 0.009 0.005368 0.009 0.005369 0.0139412 0.005932 0.0139412 0.005933 0.009 0.006532 0.009 0.006533 0.0041 0.007282 0.0041 0.007283 1.15e-06)
VPCH pch 0 PWL(0 0 0.001 0 0.001001 0 0.00154 0 0.001541 0 0.00304 0 0.003041 0 0.003604 0 0.003605 0 0.004204 0 0.004205 0 0.004768 0 0.004769 0 0.005368 0 0.005369 0 0.005932 0 0.005933 0 0.006532 0 0.006533 0 0.007282 0 0.007283 0)
BCH vdd 0 I = v(pch)
BLOAD vdd 0 I = (1/(1+exp(-(v(vdd)-2.2)/0.005))) * v(pdc)*3.0/max(v(vdd),1.0) + (1-1/(1+exp(-(v(vdd)-2.2)/0.005))) * v(pldo)
.control
set wr_singlescale
set wr_vecnames
option numdgt=7
tran 2u 0.05728 uic
wrdata supply_ADV_tx4.dat v(vdd) v(vbat) i(VOC)
quit
.endc
.end
