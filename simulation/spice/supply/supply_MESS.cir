* fluidi supply_burst - erzeugt von supply_burst.py
VOC ocv 0 DC 2.7
RINT ocv vbat 100
RHLD vbat vbat2 0.05
RFET vbat2 vdd 0.085
CB1 vdd cb1 8e-05 IC=2.7
RESR1 cb1 0 5m
CB2 vdd cb2 8e-05 IC=2.7
RESR2 cb2 0 5m
C5 vdd 0 5u IC=2.7
VPDC pdc 0 PWL(0 1.15e-06 0.001 1.15e-06 0.001001 0.0026 0.0019 0.0026 0.001901 1.15e-06 0.0319 1.15e-06 0.031901 0.0026 0.0328 0.0026 0.032801 1.15e-06 0.0628 1.15e-06 0.062801 0.0026 0.0637 0.0026 0.063701 1.15e-06 0.0937 1.15e-06 0.093701 0.0026 0.0946 0.0026 0.094601 1.15e-06)
VPLDO pldo 0 PWL(0 1.15e-06 0.001 1.15e-06 0.001001 0.0041 0.0019 0.0041 0.001901 1.15e-06 0.0319 1.15e-06 0.031901 0.0041 0.0328 0.0041 0.032801 1.15e-06 0.0628 1.15e-06 0.062801 0.0041 0.0637 0.0041 0.063701 1.15e-06 0.0937 1.15e-06 0.093701 0.0041 0.0946 0.0041 0.094601 1.15e-06)
VPCH pch 0 PWL(0 0 0.001 0 0.001001 0.0102 0.0019 0.0102 0.001901 0 0.0319 0 0.031901 0.0102 0.0328 0.0102 0.032801 0 0.0628 0 0.062801 0.0102 0.0637 0.0102 0.063701 0 0.0937 0 0.093701 0.0102 0.0946 0.0102 0.094601 0)
BCH vdd 0 I = v(pch)
BLOAD vdd 0 I = (1/(1+exp(-(v(vdd)-2.2)/0.005))) * v(pdc)*3.0/max(v(vdd),1.0) + (1-1/(1+exp(-(v(vdd)-2.2)/0.005))) * v(pldo)
.control
set wr_singlescale
set wr_vecnames
option numdgt=7
tran 2u 0.1446 uic
wrdata supply_MESS.dat v(vdd) v(vbat) i(VOC)
quit
.endc
.end
