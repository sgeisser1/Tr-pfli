# fluidi Gateway-Dienst (ARCHITECTURE.md Kap. 12.2/14) – eigener Benutzer, keine Root-Rechte
[Unit]
Description=fluidi Gateway (BLE-Sensoren, PWA, API)
After=network-online.target bluetooth.service time-sync.target
Wants=network-online.target bluetooth.service

[Service]
Type=notify
NotifyAccess=main
User=fluidi
Group=fluidi
SupplementaryGroups=bluetooth i2c
WorkingDirectory=/opt/fluidi/current/gateway
ExecStart=/opt/fluidi/venv/bin/python -m fluidi_gw serve -c /etc/fluidi/gateway.toml
# Status-LED (D-027) aus, sobald der Dienst endet (Stopp, Absturz, Watchdog); "+" = als root ohne Sandbox,
# fluidi-helper kennt nur fest programmierte Aktionen
ExecStopPost=+/usr/bin/python3 -I /usr/local/sbin/fluidi-helper led off
Restart=always
RestartSec=5
# Watchdog (REQ-FW-07): der Dienst meldet sich nur, solange der Funk-Thread lebt
WatchdogSec=60
Environment=PYTHONDONTWRITEBYTECODE=1
# Ports 80/443 ohne Root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/fluidi
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_BLUETOOTH
DevicePolicy=closed
DeviceAllow=/dev/i2c-1 rw
UMask=0077
MemoryMax=300M

[Install]
WantedBy=multi-user.target
